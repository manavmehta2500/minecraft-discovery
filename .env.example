# ---- Required: Lovable backend ----
LOVABLE_API_URL=https://your-lovable-app.example.com/api
LOVABLE_API_KEY=your_lovable_api_key

# ---- Optional: CurseForge official API (recommended for reliability) ----
# Get a free key at https://console.curseforge.com/ -> API
CURSEFORGE_API_KEY=

# ---- Tuning ----
MAX_ITEMS=1000                    # max items published per cycle across all sources
SLEEP_BETWEEN_CYCLES=3600        # seconds between cycles (default 1 hour)
DISCOVERY_MODE=FAST              # SMOKE | FAST | FULL
REQUEST_DELAY=1.0                # polite delay between HTTP calls (seconds)
REQUEST_TIMEOUT=20
MAX_RETRIES=3

# ---- Debug ----
DRY_RUN=false                    # when true, never POSTs to Lovable
